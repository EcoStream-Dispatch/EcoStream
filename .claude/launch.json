{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "api/.venv/bin/uvicorn",
      "runtimeArgs": [
        "--app-dir",
        "api",
        "index:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
