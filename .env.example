# Copy to .env (in the repo root) and fill in. Never commit .env.
# One file for everything: the frontend reads only the VITE_ lines.
# Where each value comes from: docs/SUPABASE_SETUP.md step 7.
# Supabase service-role key is for /api ONLY - never put it in the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=          # frontend
SUPABASE_SERVICE_ROLE_KEY=  # backend only
DEVICE_KEY_SALT=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE=

# Simulator (simulator/simulate.py). Keys are written here by api/scripts/new_device_key.py.
SIM_API_URL=http://localhost:8000
SIM_DEVICE_KEY_TRUCK1=
SIM_DEVICE_KEY_TRUCK2=
